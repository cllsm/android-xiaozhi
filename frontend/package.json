{
  "name": "android-xiaozhi",
  "type": "module",
  "version": "1.0.0",
  "description": "小智陪伴机器人 Android 客户端",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8"
  },
  "scripts": {
    "uvm": "npx @dcloudio/uvm@latest",
    "dev:h5": "uni",
    "dev:h5-pro": "uni --mode production",
    "dev:app": "uni -p app",
    "dev:app-android": "uni -p app-android",
    "build:h5": "uni build",
    "build:h5-prod": "uni build --mode production",
    "build:app": "uni build -p app",
    "build:app-android": "uni build -p app-android",
    "type-check": "vue-tsc --noEmit",
    "clean": "npx rimraf node_modules"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-app-plus": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "pinia": "2.2.4",
    "pinia-plugin-persistedstate": "4.1.3",
    "recorder-core": "^1.3.25011100",
    "uview-plus": "^3.8.39",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5000720260410001",
    "@dcloudio/uni-cli-shared": "3.0.0-5000720260410001",
    "@dcloudio/uni-stacktracey": "3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@uni-helper/uni-app-types": "1.0.1",
    "@uni-helper/unocss-preset-uni": "^0.2.11",
    "@unocss/preset-icons": "^66.7.0",
    "@unocss/preset-legacy-compat": "^66.7.0",
    "sass": "1.63.2",
    "typescript": "5.8.3",
    "unocss": "66.5.12",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "5.2.8",
    "vite-plugin-restart": "^2.0.0",
    "vue-tsc": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.4.21"
    }
  }
}
